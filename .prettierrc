{
    "htmlWhitespaceSensitivity": "css",
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "useTabs": false,
    "endOfLine": "auto",
    "proseWrap": "preserve",
    "quoteProps": "as-needed"
}
